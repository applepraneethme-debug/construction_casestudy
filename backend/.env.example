# ==========================================================
# Construction Inventory Management System - Environment Variables
# ==========================================================

# Server Port (default 5001 matching Vite proxy in frontend/vite.config.js)
PORT=5001

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Dedicated database name: constructionDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Target Database Name
DB_NAME=constructionDB

# Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# Secret Key for JWT Authentication (used in Phase 2)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
